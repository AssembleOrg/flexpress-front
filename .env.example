# ─── Backend ─────────────────────────────────────────────────────────────────
# En el browser las llamadas van a `/api/v1` relativo y las resuelve el rewrite
# de next.config.ts. Estas dos definen a dónde apunta ese rewrite y el fetch
# desde el server (SSR/RSC).

# Server-only. Tiene prioridad: soporta el private domain de Railway
# (*.railway.internal), que no es alcanzable desde el browser.
API_URL="http://localhost:3000"

# Fallback, queda embebida en el bundle del cliente. No poner acá nada privado.
NEXT_PUBLIC_API_URL="http://localhost:3000"

# ─── WebSocket ───────────────────────────────────────────────────────────────
# Sin esto no hay realtime: ni chat, ni matching en vivo, ni badge de
# notificaciones (ver lib/hooks/useWebSocket.ts). Apunta al backend, no al
# rewrite: Socket.IO no pasa por el proxy de Next.
# El origen tiene que estar en CORS_ORIGINS del backend.
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"

# ─── Google Maps ─────────────────────────────────────────────────────────────
# Sin esto no anda el autocompletado de direcciones. (El cálculo de km es
# Haversine local y el mapa es Leaflet/OSM: ninguno toca Google.)

# Server-only, ÚNICA key de Google. La usan app/api/geocode/route.ts y
# app/api/places/* (autocomplete + details). NO hay key de Google en el browser:
# restringila por IP (la de las Netlify Functions), nunca la pongas NEXT_PUBLIC.
GOOGLE_MAPS_API_KEY=""

# ─── Push notifications ──────────────────────────────────────────────────────
# La pública del par VAPID del backend (misma que VAPID_PUBLIC_KEY allá).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
